{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Wazoo Docs",
  "theme": "mint",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "favicon": "/images/wazoo.svg",
  "colors": {
    "primary": "#FF9800",
    "light": "#FFB74D",
    "dark": "#F57C00"
  },
  "appearance": {
    "default": "system"
  },
  "fonts": {
    "body": {
      "family": "Geist"
    }
  },
  "background": {
    "color": {
      "light": "#fafaf9",
      "dark": "#040404"
    }
  },
  "styling": {
    "eyebrows": "breadcrumbs"
  },
  "contextual": {
    "options": ["copy", "view"]
  },
  "seo": {
    "indexing": "all",
    "metatags": {
      "og:type": "website",
      "og:site_name": "Wazoo Docs",
      "canonical": "https://docs.wazoo.dev"
    }
  },
  "integrations": {
    "ga4": {
      "measurementId": "G-V64G870T6Z"
    }
  },
  "api": {
    "params": {
      "expanded": "all"
    }
  },
