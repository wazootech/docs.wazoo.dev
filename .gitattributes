# Normalize line endings to LF for all text files
* text=auto eol=lf

# Vector assets are text
*.svg text eol=lf

# Binary assets must never be normalized
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.otf binary
