{
  "name": "@wazoo/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Official documentation hub for the Wazoo project ecosystem, built with Mintlify.",
  "scripts": {
    "dev": "mintlify dev",
    "check": "mintlify validate",
    "broken-links": "mintlify broken-links",
    "format": "prettier \"**/*.{md,mdx,json}\" --write",
    "format:check": "prettier \"**/*.{md,mdx,json}\" --check",
    "precommit": "npm run format:check --silent && npm run check --silent"
  },
  "keywords": [],
  "author": "Wazoo",
  "license": "WTFPL",
  "type": "commonjs",
  "packageManager": "pnpm@12.11.2",
  "devDependencies": {
    "mintlify": "^4.2.639",
    "prettier": "^3.8.1"
  }
}
