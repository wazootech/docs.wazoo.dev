{
  "name": "@wazoo/docs",
  "version": "0.1.0",
  "private": true,
  "description": "Official documentation hub for the Wazoo project ecosystem. Starlight spike branch.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "check": "astro build",
    "preview": "astro preview",
    "format": "prettier \"**/*.{md,mdx,json,mjs,ts,astro}\" --write",
    "format:check": "prettier \"**/*.{md,mdx,json,mjs,ts,astro}\" --check",
    "precommit": "pnpm run --silent format:check && pnpm run --silent check",
    "broken-links": "echo \"skipped on starlight spike branch (mintlify-only tool)\""
  },
  "keywords": [],
  "author": "Wazoo",
  "license": "WTFPL",
  "packageManager": "pnpm@12.11.2",
  "dependencies": {
    "@astrojs/starlight": "^0.36.0",
    "astro": "^5.14.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "prettier-plugin-astro": "^0.14.1",
    "wrangler": "^4.0.0"
  }
}